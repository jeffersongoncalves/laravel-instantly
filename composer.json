{
    "name": "jeffersongoncalves/laravel-instantly",
    "description": "PHP/Laravel client for the Instantly.ai REST API: campaigns, leads, accounts, analytics and blocklist.",
    "keywords": [
        "laravel",
        "instantly",
        "instantly-ai",
        "cold-email",
        "email-marketing"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-instantly",
    "license": "MIT",
    "authors": [
        {
            "name": "Jefferson Simão Gonçalves",
            "email": "gerson.simao.92@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\Instantly\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\Instantly\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\Instantly\\InstantlyServiceProvider"
            ],
            "aliases": {
                "Instantly": "JeffersonGoncalves\\Instantly\\Facades\\Instantly"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
